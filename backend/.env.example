NODE_ENV=development
PORT=3000
APP_ORIGIN=https://tugxs.github.io
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/tugx?sslmode=require
REDIS_URL=rediss://default:PASSWORD@HOST:PORT
META_VERIFY_TOKEN=replace-with-a-long-random-token
META_APP_SECRET=replace-with-meta-app-secret
META_ACCESS_TOKEN=replace-with-system-user-access-token
META_PHONE_NUMBER_ID=replace-with-phone-number-id
ADMIN_API_KEY=replace-with-a-long-random-admin-key
